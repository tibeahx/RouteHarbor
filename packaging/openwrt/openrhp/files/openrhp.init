#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
 local enabled listen tls_cert tls_key allow_host
 config_load openrhp
 config_get_bool enabled main enabled 0
 [ "$enabled" -eq 1 ] || return 0
 config_get listen main listen '127.0.0.1:8787'
 config_get tls_cert main tls_cert ''
 config_get tls_key main tls_key ''
 config_get allow_host main allow_host ''
 [ -d /etc/openrhp/auth ] || { logger -t openrhp 'Run trusted administrator setup first'; return 1; }
 # /var/run is root-owned and not writable by the service user. Only this fixed
 # directory is handed over; contents are never traversed or recursively chowned.
 [ ! -L /var/run/openrhp-engines ] || return 1
 mkdir -p /var/run/openrhp-engines || return 1
 chown -h openrhp:openrhp /var/run/openrhp-engines || return 1
 chmod 0700 /var/run/openrhp-engines || return 1
 procd_open_instance
 procd_set_param command /usr/bin/openrhp serve --state /etc/openrhp --runtime /var/run/openrhp-engines --listen "$listen" --helper-socket /var/run/openrhp/helper.sock
 [ -n "$tls_cert" ] && procd_append_param command --tls-cert "$tls_cert"
 [ -n "$tls_key" ] && procd_append_param command --tls-key "$tls_key"
 [ -n "$allow_host" ] && procd_append_param command --allow-host "$allow_host"
 procd_set_param user openrhp
 procd_set_param group openrhp
 procd_set_param respawn 3600 5 5
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_set_param limits core="0 0" nofile="512 512"
 procd_close_instance
}

stop_service() {
 /usr/libexec/openrhp-helper quarantine --state-dir /etc/openrhp-helper
}

service_triggers() {
 procd_add_reload_trigger openrhp
}

#!/bin/sh /etc/rc.common
START=18
STOP=89
USE_PROCD=1

start_service() {
 local api_uid
 api_uid="$(id -u openrhp)" || return 1
 [ "$api_uid" -ne 0 ] || return 1
 mkdir -p /etc/openrhp-helper
 chmod 0700 /etc/openrhp-helper
 chown root:root /etc/openrhp-helper
 # Synchronously install the saved guard before later network boot scripts.
 /usr/libexec/openrhp-helper quarantine --state-dir /etc/openrhp-helper || return 1
 # BootGuard also runs before the helper socket becomes available.
 procd_open_instance
 procd_set_param command /usr/libexec/openrhp-helper serve --state-dir /etc/openrhp-helper --socket /var/run/openrhp/helper.sock --uid "$api_uid"
 procd_set_param respawn 3600 5 5
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_set_param limits core="0 0" nofile="256 256"
 procd_close_instance
}

stop_service() {
 /usr/libexec/openrhp-helper quarantine --state-dir /etc/openrhp-helper
}

reload_service() {
 /usr/libexec/openrhp-helper quarantine --state-dir /etc/openrhp-helper
}

service_triggers() {
 procd_add_reload_trigger firewall network
}

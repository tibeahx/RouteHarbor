#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1
start_service() {
 local enabled listen
 config_load routeharbor-node
 config_get_bool enabled main enabled 0
 [ "$enabled" -eq 1 ] || return 0
 config_get listen main listen '127.0.0.1:9844'
 [ -d /etc/routeharbor-node ] || return 1
 procd_open_instance
 procd_set_param command /usr/bin/routeharbor-node serve --state-dir /etc/routeharbor-node --helper-socket /var/run/routeharbor-node-helper.sock --listen "$listen"
 procd_set_param user routeharbor-node
 procd_set_param group routeharbor-node
 procd_set_param respawn 3600 5 5
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_set_param limits core="0 0" nofile="128 128"
 procd_close_instance
}
service_triggers() {
 procd_add_reload_trigger routeharbor-node
}

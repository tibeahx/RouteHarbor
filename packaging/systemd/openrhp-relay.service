[Unit]
Description=OpenRHP private session relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=openrhp-relay
Group=openrhp-relay
StateDirectory=openrhp-relay
StateDirectoryMode=0700
UMask=0077
ExecStart=/usr/local/bin/openrhp-relay serve --state /var/lib/openrhp-relay --config /etc/openrhp-relay/config.json
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/openrhp-relay
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
LockPersonality=true
LimitCORE=0
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
